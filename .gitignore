# Build outputs and caches
.gradle/
.kotlin/
build/
**/build/
**/node_modules/

# IDE files
.idea/
.vscode/
*.iml

# Sensitive configurations (API keys, IP addresses, credentials)
**/config.json
**/.env
local.properties

# Android release signing (upload key and its passwords)
**/keystore.properties
*.jks
*.keystore

# Logs and runtime files
*.log
**/ac_tray_app.log
**/tunnel_url.txt
.DS_Store

# Runtime error logs (may contain server IPs, ports, debug PINs)
*.err

# Python cache and build artifacts
**/__pycache__/
midea-ac-server/dist/
midea-ac-server/static/audio/tts/

# Release binaries are published on GitHub Releases, not committed
/*.exe
/*.apk
/*.aab

