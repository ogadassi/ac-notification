<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/btn_turn_on_ac"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You're almost home! 🏠"
            android:textColor="@color/notification_title_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notification_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turn on the AC before you arrive?"
            android:textColor="@color/notification_body_color"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Circular Play Accent Button matching the app theme -->
    <ImageView
        android:id="@+id/btn_turn_on_ac"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:background="@drawable/btn_accent_pill"
        android:src="@android:drawable/ic_media_play"
        android:tint="#050b14"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true" />
</RelativeLayout>
